# Copier en .env et remplir au fur et à mesure.
# Toutes les valeurs sont OPTIONNELLES : sans elles, le backend tourne en mode démo.

# --- Serveur ---
PORT=4000
API_PREFIX=/api/v1

# --- Auth ---
# Si défini -> vraie auth par jeton JWT. Sinon mode démo (jeton libre = user de test).
JWT_SECRET=

# --- Base de données ---
# Si défini -> MongoDB (Atlas par ex.). Sinon store en mémoire.
MONGODB_URI=

# --- Stockage des images ---
# local (défaut) | s3 | ipfs
STORAGE=local
PUBLIC_BASE_URL=http://localhost:4000
# S3 :
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# IPFS (web3.storage) :
WEB3_STORAGE_TOKEN=

# --- Blockchain (mint NFT gas-free Polygon) ---
# Si RPC + clé privée + contrat fournis -> vrai mint. Sinon mint simulé.
POLYGON_RPC_URL=
MINTER_PRIVATE_KEY=
NFT_CONTRACT_ADDRESS=
CHAIN=polygon-amoy

# --- Paiements ---
# Si défini -> vrais paiements Stripe. Sinon simulé.
STRIPE_SECRET_KEY=
MINT_PRICE=2.99
CURRENCY=EUR
